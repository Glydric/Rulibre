{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rulibre",
  "version": "0.1.2",
  "identifier": "dev.miglio.rulibre",
  "build": {
    "frontendDist": "./dist",
    "beforeBuildCommand": "cd rulibre-gui && trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rulibre",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Lightweight Calibre alternative",
    "longDescription": "Browse your Calibre library and transfer books to your e-reader.",
    "icon": ["../../assets/screenshot.png"]
  }
}
